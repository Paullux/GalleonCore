#
# User service: galleond starts with the graphical session and is restarted
# if it stops. Installed by `cmake --install` in lib/systemd/user/; enable it with
#   systemctl --user enable --now galleond.service
# To run from the build tree instead, see tools/systemd/galleond-dev.service.

[Unit]
Description=GalleonCore daemon (Corsair Galleon 100 SD Stream Deck module)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/galleond
# The module may be unplugged or the player absent: galleond waits for them by
# itself. A real failure (another galleond running exits with 1) is retried slowly.
Restart=on-failure
RestartSec=5
# Only galleond itself is stopped with the service. The live lighting starts a watchdog next to it (galleon-keyboard-watchdog)
# that must OUTLIVE a crash or a stop of galleond: it is the one that gives the keyboard's keys back. With the default
# KillMode=control-group systemd would kill it together with galleond, at the very moment it is needed. It ends by itself
# once it has looked at the keyboard, so nothing is left running (systemd may log that a process remained after the stop).
KillMode=process

[Install]
WantedBy=graphical-session.target
