// The Galleon 100 SD drawn from this project's own measurements (KeyboardMapData.js, generated by
// tools/keyboard-map/build_map.py): the key caps, and the module with its screen, its 12 keys and its two dials.
// As on the real keys, a cap is dark and its legend and its outline are see-through: the light of the lamps under
// it shows through them, so a cap is drawn as a ring and a legend in the colour of its lamps around a dark body.
// A cap can be clicked to be coloured; the colours live in the parent (`colors`, by lamp) and are only drawn here.
// QML draws and forwards: nothing in this file talks to the keyboard, and the caps are decoration, not
// measurements (the lamps are: each belongs to the cap it is nearest to, `lamps` in the data).
pragma ComponentBehavior: Bound
import QtQuick
import "KeyboardMapData.js" as MapData

Item {
    id: board

    // lamp id -> "#rrggbb" for the lamps that have a colour; the others are drawn white, as a keyboard lit white.
    property var colors: ({})
    // The index of the cap that was chosen, or -1.
    property int selected: -1
    // The theme the module shows: its 12 keys come from tileSource(index), a function giving an image URL.
    property var tileSource: null
    property string themeName: ""
    property color themeColor: "#9aa0a6"
    // A cap was clicked: its index and the lamps under it.
    signal capClicked(int index, var lamps)

    readonly property var map: MapData.map
    readonly property real margin: 4
    // Pixels per millimetre.
    readonly property real scale: width / (map.body.w + 2 * margin)
    readonly property real originX: map.body.x - margin
    readonly property real originY: map.body.y - margin
    // The thickness of the see-through outline of a cap, in millimetres.
    readonly property real rim: 0.55
    readonly property var allLamps: map.cells.map(cell => cell.id)
    readonly property color unlit: "#e8eaed"

    implicitHeight: (map.body.h + 2 * margin) * scale
    height: implicitHeight
    Accessible.role: Accessible.Graphic
    Accessible.name: qsTr("The keyboard and the Stream Deck module, drawn from their measurements")

    // A colour for every lamp, going round the hue circle from left to right across the keyboard (a preview of a
    // lighting that looks like the ones of the Web Hub).
    function rainbow() {
        const xs = map.cells.map(cell => cell.x)
        const low = Math.min(...xs)
        const span = Math.max(...xs) - low
        const colours = {}
        for (const cell of map.cells)
            colours[cell.id] = Qt.hsla(0.85 * (cell.x - low) / span, 0.9, 0.55, 1).toString()
        return colours
    }

    function xp(mm) { return (mm - originX) * scale }
    function yp(mm) { return (mm - originY) * scale }

    Rectangle {
        x: board.xp(board.map.body.x)
        y: board.yp(board.map.body.y)
        width: board.map.body.w * board.scale
        height: board.map.body.h * board.scale
        radius: board.map.body.radius * board.scale
        color: "#16181c"
        border.width: 1
        border.color: "#3a3f47"
    }

    // The light bar above the function row: decoration, drawn like a cap whose light is white.
    Rectangle {
        x: board.xp(board.map.strip.x)
        y: board.yp(board.map.strip.y)
        width: board.map.strip.w * board.scale
        height: board.map.strip.h * board.scale
        radius: 2.4 * board.scale
        color: board.unlit
        Rectangle {
            anchors.fill: parent
            anchors.margins: Math.max(1, board.rim * board.scale)
            radius: parent.radius - board.rim * board.scale
            color: "#1c1e22"
        }
    }

    // The key caps (decoration): the light under, then the dark body with the legend and the outline left see-through.
    Repeater {
        model: board.map.caps
        Rectangle {
            id: cap
            required property var modelData
            required property int index
            // The light of a cap is the colour of its first lamp; a cap with no colour is lit white.
            readonly property color light: modelData.lamps.length > 0 && board.colors[modelData.lamps[0]] !== undefined
                                           ? board.colors[modelData.lamps[0]] : board.unlit
            objectName: "cap" + index
            x: board.xp(modelData.x)
            y: board.yp(modelData.y)
            width: modelData.w * board.scale
            height: modelData.h * board.scale
            radius: 1.6 * board.scale
            color: light // the ring: this is what shows through the outline
            border.width: board.selected === index ? 2 : 0
            border.color: "#64b5f6"
            Accessible.role: Accessible.Button
            Accessible.name: modelData.label !== "" ? qsTr("Key %1").arg(modelData.label) : qsTr("Key")
            Rectangle {
                anchors.fill: parent
                anchors.margins: Math.max(1, board.rim * board.scale)
                radius: Math.max(0, parent.radius - board.rim * board.scale)
                color: "#1c1e22" // the dark body of the cap
                Text {
                    anchors.centerIn: parent
                    anchors.verticalCenterOffset: -board.scale * 0.6
                    color: cap.light // the legend is see-through: the light shows in its shape
                    font.pixelSize: Math.max(8, board.scale * 4.6)
                    text: cap.modelData.label
                }
            }
            MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onClicked: board.capClicked(cap.index, cap.modelData.lamps)
            }
        }
    }

    // The module: the screen, the 12 keys of the theme last looked at, the two dials.
    Rectangle {
        x: board.xp(board.map.module.screen.x)
        y: board.yp(board.map.module.screen.y)
        width: board.map.module.screen.w * board.scale
        height: board.map.module.screen.h * board.scale
        radius: 2 * board.scale
        color: "#0d0e10"
        border.width: 1
        border.color: board.themeColor
        Text {
            anchors.centerIn: parent
            width: parent.width - 8
            horizontalAlignment: Text.AlignHCenter
            elide: Text.ElideRight
            color: board.themeColor
            font.pixelSize: Math.max(10, board.scale * 6)
            font.bold: true
            text: board.themeName
        }
    }
    Repeater {
        model: board.map.module.keys
        Rectangle {
            id: moduleKey
            required property var modelData
            x: board.xp(modelData.x)
            y: board.yp(modelData.y)
            width: modelData.size * board.scale
            height: modelData.size * board.scale
            radius: 1.8 * board.scale
            color: "#0d0e10"
            border.width: 1
            border.color: "#4a4f57"
            clip: true
            Image {
                anchors.fill: parent
                anchors.margins: 1
                fillMode: Image.PreserveAspectFit
                asynchronous: true
                cache: false
                sourceSize.width: 96
                sourceSize.height: 96
                source: board.tileSource ? board.tileSource(moduleKey.modelData.index) : ""
            }
        }
    }
    Repeater {
        model: board.map.module.dials
        Rectangle {
            id: dial
            required property var modelData
            x: board.xp(modelData.x - modelData.r)
            y: board.yp(modelData.y - modelData.r)
            width: 2 * modelData.r * board.scale
            height: width
            radius: width / 2
            color: "#23262b"
            border.width: 1
            border.color: board.themeColor
        }
    }
}
